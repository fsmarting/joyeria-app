model Muestrario {
  id Int @id @default(autoincrement())
  empresaId Int
  // ── NUEVO — número correlativo MST-{año}-{consecutivo}, igual patrón
  // que OrdenProduccion.numero (generado en el servidor, no editable).
  numero String @db.VarChar(20)
  vendedoraId Int
  fechaSalida DateTime @default(now())
  fechaCierre DateTime?
  estado String @default("ACTIVO")
  nota String? @db.VarChar(500)
  usu_creacion String? @db.VarChar(30)
  usu_actualizacion String? @db.VarChar(30)
  version Int @default(1)
  deletedAt DateTime?
  empresa Empresa @relation("Muestrario_Empresa", fields: [empresaId], references: [id])
  vendedora Usuario @relation("Muestrario_Vendedora", fields: [vendedoraId], references: [id])
  items MuestrarioItem[] @relation("MuestrarioItem_Muestrario")
  @@index([empresaId])
  @@index([vendedoraId])
}

model MuestrarioItem {
  id Int @id @default(autoincrement())
  muestrarioId Int
  productoId Int
  cantidadEntregada Int @default(1)
  cantidadDevuelta Int @default(0)
  // ── NUEVO — fecha en que ESTE producto entró al muestrario. Antes solo
  // existía Muestrario.fechaSalida (fecha de creación del muestrario
  // completo) — si un producto se agregaba después con
  // agregarItemMuestrario, no había forma de saber cuándo salió ese
  // producto en particular. Hace falta para atribuir correctamente el mes
  // en el Kardex de inventario (ver conversación sobre visibilidad de
  // inventario). Los registros existentes antes de esta migración quedan
  // con la fecha de la migración (no hay forma de recuperar la fecha real).
  fechaEntrega DateTime @default(now())
  version Int @default(1)
  deletedAt DateTime?
  muestrario Muestrario @relation("MuestrarioItem_Muestrario", fields: [muestrarioId], references: [id], onDelete: Cascade)
  producto Producto @relation("MuestrarioItem_Producto", fields: [productoId], references: [id])
  // ── CAMBIO (ronda 34) — antes apuntaba a Venta (la cabeza). Ahora
  // apunta a VentaDetalle (la línea) — ver conversación sobre separar
  // cabeza/detalle en Ventas.
  ventaDetalles VentaDetalle[] @relation("VentaDetalle_MuestrarioItem")
  @@index([muestrarioId])
}

// ── NUEVO — ajustes manuales de inventario (pérdida o hallazgo) que no
// vienen de ningún flujo de negocio existente (venta, producción,
// muestrario). Todo ajuste requiere motivo — nunca se permite un cambio de
// stock sin explicación por escrito (ver conversación sobre visibilidad de
// inventario). Mismo patrón de numeración que OrdenProduccion/Cotizacion/
// Muestrario (numero autogenerado AJI-{año}-{consecutivo}, sin restricción
// unique en BD, ver generarNumeroAjuste en producto.resolvers.js).
model AjusteInventario {
  id Int @id @default(autoincrement())
  empresaId Int
  productoId Int
  numero String @db.VarChar(20)
  tipoMovimiento String @db.VarChar(20) // PERDIDA | HALLAZGO
  cantidad Int
  motivo String @db.VarChar(500)
  fecha DateTime @default(now())
  usu_creacion String? @db.VarChar(30)
  version Int @default(1)
  deletedAt DateTime?
  empresa Empresa @relation("AjusteInventario_Empresa", fields: [empresaId], references: [id])
  producto Producto @relation("AjusteInventario_Producto", fields: [productoId], references: [id])
  @@index([empresaId, productoId])
}

// ── NUEVO (ronda 36) — Ajustes de Inventario, ahora para Insumos ────
// Mismo patrón que AjusteInventario (arriba), pero para insumos que se
// pierden estando todavía en la bodega de Río Rayo (nunca llegaron a
// manos de ningún joyero) — deber ser acordado con el usuario: eso es
// distinto del material que sí llegó a un joyero (ese se resuelve con
// el Mecanismo 1 de entrada+salida en MovimientoInsumoOrden, no aquí).
// Requiere compraInsumoId porque cada gramo/unidad disponible de un
// insumo vive en un lote específico con su propio costo real — hay que
// saber de cuál lote sale la pérdida. Solo soporta "PERDIDA" por ahora
// (el usuario no pidió "HALLAZGO" para insumos); tipoMovimiento queda
// como texto libre para poder agregarlo después sin migrar de nuevo.
model AjusteInsumo {
  id Int @id @default(autoincrement())
  empresaId Int
  piedraId Int
  compraInsumoId Int
  numero String @db.VarChar(20)
  tipoMovimiento String @db.VarChar(20) // PERDIDA | HALLAZGO (ronda 38 — Opción A: el hallazgo también se atribuye a un lote existente)
  cantidad Decimal @db.Decimal(14,4)
  motivo String @db.VarChar(500)
  fecha DateTime @default(now())
  usu_creacion String? @db.VarChar(30)
  version Int @default(1)
  deletedAt DateTime?
  empresa Empresa @relation("AjusteInsumo_Empresa", fields: [empresaId], references: [id])
  piedra Piedra @relation("AjusteInsumo_Piedra", fields: [piedraId], references: [id])
  compraInsumo CompraInsumo @relation("AjusteInsumo_Compra", fields: [compraInsumoId], references: [id])
  @@index([empresaId, piedraId])
}

model Cotizacion {
  id               Int       @id @default(autoincrement())
  empresaId        Int
  numero           String    @db.VarChar(20)
  clienteId        Int?
  conversacionId   Int?
  vendedoraId      Int?
  fecha            DateTime  @default(now())
  validezDias      Int       @default(15)
  estadoId         Int
  nota             String?   @db.VarChar(500)
  usu_creacion     String?   @db.VarChar(30)
  usu_actualizacion String?  @db.VarChar(30)
  version          Int       @default(1)
  deletedAt        DateTime?

  empresa      Empresa      @relation("Cotizacion_Empresa",       fields: [empresaId],      references: [id])
  cliente      Tercero?     @relation("Cotizacion_Cliente",       fields: [clienteId],      references: [id])
  conversacion Conversacion?@relation("Cotizacion_Conversacion",  fields: [conversacionId], references: [id])
  vendedora    Usuario?     @relation("Cotizacion_Vendedora",     fields: [vendedoraId],    references: [id])
  estado       Grupo        @relation("Cotizacion_Estado",        fields: [estadoId],       references: [id])
  items        CotizacionItem[] @relation("CotizacionItem_Cotizacion")
  // ── CAMBIO — la relación a Venta ahora vive en CotizacionItem (la línea),
  // no aquí en la cabeza. Ver CotizacionItem.ventas.

  @@unique([empresaId, numero])
  @@index([empresaId])
}


model CotizacionItem {
  id             Int       @id @default(autoincrement())
  cotizacionId   Int
  productoId     Int
  precioUnitario Decimal   @default(0) @db.Decimal(12,2)
  cantidad       Int       @default(1)
  subtotal       Decimal   @default(0) @db.Decimal(12,2)
  nota           String?   @db.VarChar(300)
  // ── NUEVO (ronda 39) — desglose de IVA congelado al momento de crear
  // esta línea de cotización (informativo — NO es fiscalmente vinculante
  // porque todavía no hay dinero de por medio, pero se congela igual para
  // que si alguien reimprime la cotización días después, siga mostrando
  // los mismos números con los que se imprimió/envió la primera vez,
  // aunque el % de IVA del producto ya haya cambiado). precioUnitario ya
  // incluye IVA; baseGravable + valorIva == precioUnitario.
  porcentajeIva  Decimal   @default(19) @db.Decimal(5,2)
  baseGravable   Decimal   @default(0) @db.Decimal(12,2)
  valorIva       Decimal   @default(0) @db.Decimal(12,2)
  version        Int       @default(1)
  deletedAt      DateTime?

  cotizacion Cotizacion @relation("CotizacionItem_Cotizacion", fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto   Producto   @relation("CotizacionItem_Producto",   fields: [productoId],   references: [id])
  // ── CAMBIO (ronda 34) — antes apuntaba a Venta (la cabeza, cuando cada
  // venta era 1 solo producto). Ahora apunta a VentaDetalle (la línea).
  ventaDetalles VentaDetalle[] @relation("VentaDetalle_CotizacionItem")

  @@index([cotizacionId])
}
